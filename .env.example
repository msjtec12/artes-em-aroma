# Artes em Aroma — Variáveis de Ambiente
# Em produção (Vercel / Neon), defina DATABASE_URL com a string de conexão do Neon PostgreSQL.
# Em ambiente local sem DATABASE_URL externo, o sistema utiliza PGlite (PostgreSQL embarcado persistente em ./data/pglite) para funcionamento imediato e testes.
DATABASE_URL=""

# Segredo criptográfico para assinatura de sessão JWT administrativa (mínimo 32 caracteres)
AUTH_SECRET="artes-em-aroma-secret-key-change-in-production-2026"

# URL canônica pública do site
NEXT_PUBLIC_SITE_URL="https://artesemaroma.com.br"

# Integrações opcionais de Visibilidade Digital (GA4 e Google Search Console)
NEXT_PUBLIC_GA4_ID=""
GSC_SITE_URL=""
GSC_SERVICE_ACCOUNT_JSON=""

# Provedor de Object Storage (ex: Vercel Blob / S3 / R2). Se vazio em dev, salva em public/uploads
BLOB_READ_WRITE_TOKEN=""

# Senha administrativa de bootstrap: configure apenas em ambiente seguro (mínimo 16 caracteres)
ADMIN_INITIAL_EMAIL="admin@artesemaroma.com.br"
ADMIN_INITIAL_PASSWORD=""
